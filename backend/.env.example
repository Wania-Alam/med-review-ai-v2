# Copy to .env for local development. On Render, set these in the dashboard instead.
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/medreview?retryWrites=true&w=majority
JWT_SECRET=put-a-long-random-string-here
# Doctors must enter this code to create an account (share it only with your hospital staff)
REGISTRATION_CODE=choose-a-hospital-code

# ---- AI (OpenAI-compatible API) ----
# Deployed (free, open-source Llama models hosted by Groq):
AI_BASE_URL=https://api.groq.com/openai/v1
AI_API_KEY=gsk_your_groq_key
AI_MODEL=llama-3.3-70b-versatile
AI_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
# Local with Ollama instead (comment the 4 lines above, use these):
# AI_BASE_URL=http://localhost:11434/v1
# AI_API_KEY=ollama
# AI_MODEL=llama3.1:8b
# AI_VISION_MODEL=llava
